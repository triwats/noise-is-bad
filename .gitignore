# Editor
.idea

.eslintcache

# Build and tooling caches, never committed.
/.cache/

# Packaged plugin builds produced by the sign/package step.
*.zip

# The assembled project site, built by site/build.sh.
/_site/

# The demo server's settings live only on the server.
/deploy/.env
/deploy/.env.*
!/deploy/.env.example

