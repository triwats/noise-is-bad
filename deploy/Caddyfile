# noise is bad.: the project site at /, the public demo at /demo/.
#
# Nothing reaches Caddy from the internet directly. Visitors arrive through a
# Cloudflare Tunnel: cloudflared dials out to Cloudflare and hands requests to
# Caddy over the internal network, so the server publishes no ports at all.
# Cloudflare terminates HTTPS, which is why Caddy serves plain HTTP here.
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-Via
	}

	# --- the demo: Grafana, served from /demo/ -------------------------------

	# The way in is the demo, full screen, as a television would show it.
	redir /demo /demo/ 302
	redir /demo/ /demo/d/a538aeff-5a8a-42a5-901c-938d896fdd6f/noise-is-bad?viewPanel=1&kiosk 302

	# Grafana pages a viewer has no business on. Grafana already refuses the
	# actions behind most of them; this keeps the pages themselves out of reach.
	@pages path /demo/login* /demo/signup* /demo/user/* /demo/profile* /demo/explore* /demo/drilldown* /demo/admin* /demo/org* /demo/connections* /demo/datasources* /demo/plugins* /demo/a/* /demo/alerting* /demo/dashboard/new* /demo/dashboard/import* /demo/dashboard/snapshots* /demo/library-panels* /demo/playlists* /demo/swagger* /demo/openapi*
	redir @pages /demo/ 302

	# API surface the panel never needs: the plugin list, the raw datasource
	# proxy, the grafana.com proxy, snapshots, admin, and Grafana's own metrics.
	@api path /demo/api/plugins /demo/api/datasources /demo/api/datasources/proxy/* /demo/api/gnet/* /demo/api/snapshots* /demo/api/snapshot/* /demo/api/admin/* /demo/api/playlists* /demo/api/live/* /demo/metrics /demo/metrics/*

	# The 404 sits inside the same block as the proxy on purpose: Caddy runs
	# `handle` before a top-level `respond`, so outside it the proxy would win
	# and these paths would reach Grafana. deploy/check.sh tests every one.
	handle /demo/* {
		respond @api 404
		reverse_proxy grafana:3000
	}

	# --- the project site, built by deploy/build-site.sh ---------------------

	handle {
		root * /srv/site
		file_server {
			hide .*
		}
	}
}
