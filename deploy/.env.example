# Copy to .env and adjust. Every value has a default in compose.yaml.

# The public address. Its DNS A record must point at this server.
DOMAIN=demo.noiseisbad.triwats.com
ROOT_URL=https://demo.noiseisbad.triwats.com/
# Optional: Let's Encrypt writes here if a certificate is about to expire.
ACME_EMAIL=

# Which release of the panel to run. Changing it and re-running
# `docker compose up -d` downloads the new zip once.
PLUGIN_VERSION=1.0.0
# Optional: the zip's sha256, from the release page. Refuses anything else.
PLUGIN_SHA256=

# Sites allowed to put the demo in an iframe, space separated.
EMBED_ORIGINS=https://noiseisbad.triwats.com

# Pinned images. Bump deliberately; see README.md.
GRAFANA_VERSION=13.1.0
CADDY_VERSION=2.10.2
PROMETHEUS_VERSION=v3.1.0
